    },
    {
      "id": "Fyn79BpzZLHnoRAcHlR10",
      "type": "text",
      "x": 1929.2283020019531,
      "y": 169.99222564697266,
      "width": 509.21954345703125,
      "height": 300,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bK7",
      "roundness": null,
      "seed": 627871395,
      "version": 623,
      "versionNonce": 488074136,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1785179730116,
      "link": null,
      "locked": false,
      "text": "CURRENT Infrastructure:\n\n\nEC2 instances running the application.\n\nS3 bucket storing user data and application assets.\n\nRDS database for user information.\n\nCloudWatch for monitoring.\n\nIAM for Authorization.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "CURRENT Infrastructure:\n\n\nEC2 instances running the application.\n\nS3 bucket storing user data and application assets.\n\nRDS database for user information.\n\nCloudWatch for monitoring.\n\nIAM for Authorization.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "_7lu5bwP2qkYd_l1qCFrd",
      "type": "text",
      "x": 1924.6410827636719,
      "y": 657.7609252929688,
      "width": 777.34033203125,
      "height": 775,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bK8",
      "roundness": null,
      "seed": 869827742,
      "version": 1374,
      "versionNonce": 635086056,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1785179669296,
      "link": null,
      "locked": false,
      "text": "IMPROVED Infrastructure:\n\n✅ Multi-AZ Auto Scaling Groups (ASG) for Web and App \nEC2 tiers behind a regional ALB to ensure high availability\nand dynamic scaling.\n\n✅ Decoupled Architecture: Public web servers handle client\nHTTP/HTTPS requests from the ALB, while isolated private \napp servers execute backend business logic.\n\n✅ Secure S3 Access: Application assets and user data stored in S3, \naccessed privately via VPC Gateway Endpoints to avoid public \ninternet routing and reduce data transfer costs.\n\n✅ Multi-AZ RDS Instance: High-availability primary database with \nsynchronous standby replication for automatic failover.\n\n✅ CloudWatch: Custom dashboards and automated CPU/memory \nthreshold alarms triggering SNS notifications for rapid incident response.\n\n✅ IAM: Role-based group access & mandatory MFA. Replaced root account\nusage with individual user accounts organised into four groups (Developers, \nOperations, Finance, Analysts). Attached permission policies per group \naccording to job role (including enabling root billing settings) and enforced\na mandatory MFA policy before any AWS actions can be performed.\n\n✅ GuardDuty: ML-powered continuous monitoring of VPC Flow and DNS logs \nwith EventBridge/Lambda for automated threat containment.\n\n✅ Security Groups: Multi-tier, stateful firewall rules restricting inbound access\nstrictly to upstream tiers (ALB -> Web -> App -> RDS).",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "IMPROVED Infrastructure:\n\n✅ Multi-AZ Auto Scaling Groups (ASG) for Web and App \nEC2 tiers behind a regional ALB to ensure high availability\nand dynamic scaling.\n\n✅ Decoupled Architecture: Public web servers handle client\nHTTP/HTTPS requests from the ALB, while isolated private \napp servers execute backend business logic.\n\n✅ Secure S3 Access: Application assets and user data stored in S3, \naccessed privately via VPC Gateway Endpoints to avoid public \ninternet routing and reduce data transfer costs.\n\n✅ Multi-AZ RDS Instance: High-availability primary database with \nsynchronous standby replication for automatic failover.\n\n✅ CloudWatch: Custom dashboards and automated CPU/memory \nthreshold alarms triggering SNS notifications for rapid incident response.\n\n✅ IAM: Role-based group access & mandatory MFA. Replaced root account\nusage with individual user accounts organised into four groups (Developers, \nOperations, Finance, Analysts). Attached permission policies per group \naccording to job role (including enabling root billing settings) and enforced\na mandatory MFA policy before any AWS actions can be performed.\n\n✅ GuardDuty: ML-powered continuous monitoring of VPC Flow and DNS logs \nwith EventBridge/Lambda for automated threat containment.\n\n✅ Security Groups: Multi-tier, stateful firewall rules restricting inbound access\nstrictly to upstream tiers (ALB -> Web -> App -> RDS).",
      "autoResize": true,
      "lineHeight": 1.25
    },
